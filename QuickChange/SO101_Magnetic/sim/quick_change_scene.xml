<mujoco model="SO101 powered magnetic quick change with positive lock">
  <compiler angle="degree" meshdir="../exports"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <statistic center="0 -0.02 0" extent="0.12"/>

  <asset>
    <mesh name="robot_plate_mesh" file="so101_robot_plate.stl" scale="0.001 0.001 0.001"/>
    <mesh name="tool_plate_mesh" file="so101_tool_plate.stl" scale="0.001 0.001 0.001"/>
    <mesh name="tool_dock_mesh" file="so101_passive_tool_dock.stl" scale="0.001 0.001 0.001"/>
    <material name="robot_yellow" rgba="0.95 0.68 0.08 1"/>
    <material name="tool_blue" rgba="0.10 0.38 0.90 1"/>
    <material name="dock_dark" rgba="0.18 0.20 0.23 1"/>
    <material name="magnet" rgba="0.62 0.18 0.82 1" metallic="0.35" roughness="0.25"/>
    <material name="steel" rgba="0.72 0.75 0.78 1" metallic="0.7" roughness="0.25"/>
    <material name="lock_green" rgba="0.10 0.75 0.34 0.9"/>
    <material name="contact_gold" rgba="1.0 0.66 0.08 1" metallic="0.65" roughness="0.2"/>
  </asset>

  <worldbody>
    <light pos="0.1 -0.2 0.35" dir="-0.2 0.3 -1" directional="true"/>
    <camera name="overview" pos="0.15 -0.22 0.14" xyaxes="0.83 0.56 0 -0.28 0.42 0.86"/>
    <geom name="floor" type="plane" pos="0 0 -0.010" size="0.3 0.3 0.01" rgba="0.08 0.09 0.11 1"/>
    <geom name="dock_visual" type="mesh" mesh="tool_dock_mesh" material="dock_dark"
          contype="0" conaffinity="0"/>

    <body name="robot_plate" mocap="true" pos="0 0 -0.055">
      <geom type="mesh" mesh="robot_plate_mesh" material="robot_yellow" contype="0" conaffinity="0"/>
      <geom type="box" pos="0 -0.016 0.0075" size="0.006 0.006 0.002" material="magnet" contype="0" conaffinity="0"/>
      <geom type="box" pos="0 0.016 0.0075" size="0.006 0.006 0.002" material="magnet" contype="0" conaffinity="0"/>
      <geom type="box" pos="0.003 0 0.0055" size="0.020 0.0024 0.0008" material="lock_green" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="-0.031 -0.0075 0.0097" size="0.00105 0.0007" material="contact_gold" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="-0.031 -0.0025 0.0097" size="0.00105 0.0007" material="contact_gold" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="-0.031 0.0025 0.0097" size="0.00105 0.0007" material="contact_gold" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="-0.031 0.0075 0.0097" size="0.00105 0.0007" material="contact_gold" contype="0" conaffinity="0"/>
      <site name="robot_mating_face" pos="0 0 0.0095" size="0.001" rgba="1 0.8 0.1 1"/>
    </body>

    <body name="tool_plate" pos="0 0 0">
      <freejoint name="tool_plate_free"/>
      <inertial pos="0 0 0.00475" mass="0.050" diaginertia="0.00003 0.00003 0.00005"/>
      <geom type="mesh" mesh="tool_plate_mesh" material="tool_blue" contype="0" conaffinity="0"/>
      <geom type="box" pos="0 -0.016 0.0015" size="0.006 0.006 0.0015" material="steel" contype="0" conaffinity="0"/>
      <geom type="box" pos="0 0.016 0.0015" size="0.006 0.006 0.0015" material="steel" contype="0" conaffinity="0"/>
      <geom name="tool_collision" type="box" pos="-0.002 0 0.00475" size="0.034 0.025 0.00475"
            rgba="0 0 0 0" mass="0"/>
      <site name="tool_mating_face" pos="0 0 0" size="0.001" rgba="0.1 0.7 1 1"/>
    </body>
  </worldbody>

  <equality>
    <weld name="tool_in_dock" body1="tool_plate" active="true" solref="0.004 1"/>
    <weld name="magnetic_attach" body1="robot_plate" body2="tool_plate" active="false"
          solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <weld name="positive_lock" body1="robot_plate" body2="tool_plate" active="false"
          solref="0.003 1" solimp="0.98 0.995 0.001"/>
  </equality>
</mujoco>
