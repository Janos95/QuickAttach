<mujoco model="SO101 box stacking">
  <include file="so101_new_calib.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic"/>
  <statistic center="0.22 0 0.14" extent="0.55"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.18 0.22 1"/>
    <global azimuth="145" elevation="-24"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.38 0.52" rgb2="0.03 0.04 0.06"
             width="512" height="3072"/>
    <texture type="2d" name="floor_grid" builtin="checker" mark="edge"
             rgb1="0.16 0.18 0.20" rgb2="0.09 0.10 0.12" markrgb="0.30 0.32 0.35"
             width="300" height="300"/>
    <material name="floor_grid" texture="floor_grid" texuniform="true" texrepeat="6 6" reflectance="0.12"/>
    <material name="worktop" rgba="0.55 0.49 0.40 1" roughness="0.9"/>
    <material name="red_box" rgba="0.88 0.18 0.14 1" roughness="0.7"/>
    <material name="blue_box" rgba="0.10 0.38 0.90 1" roughness="0.7"/>
    <material name="target" rgba="0.15 0.85 0.40 0.32" emission="0.08"/>
  </asset>

  <worldbody>
    <light pos="0.05 -0.25 1.2" dir="0.2 0.1 -1" directional="true"/>
    <light pos="0.55 0.35 0.65" dir="-0.5 -0.2 -0.7" directional="true" diffuse="0.35 0.35 0.35"/>
    <camera name="overview" pos="0.64 -0.72 0.48" xyaxes="0.74 0.67 0 -0.31 0.34 0.89"/>

    <geom name="floor" type="plane" pos="0 0 -0.002" size="1 1 0.05" material="floor_grid"/>
    <geom name="work_surface" type="box" pos="0.27 0 0.015" size="0.25 0.22 0.015"
          material="worktop" friction="1.2 0.01 0.001"/>

    <geom name="stack_target" type="cylinder" pos="0.27 0.105 0.031" size="0.043 0.001"
          material="target" contype="0" conaffinity="0"/>

    <body name="red_box" pos="0.22 -0.105 0.057">
      <freejoint name="red_box_free"/>
      <geom name="red_box_geom" type="box" size="0.026 0.026 0.026" mass="0.035"
            material="red_box" friction="1.3 0.01 0.001" solref="0.004 1"/>
    </body>

    <body name="blue_box" pos="0.33 -0.095 0.057">
      <freejoint name="blue_box_free"/>
      <geom name="blue_box_geom" type="box" size="0.026 0.026 0.026" mass="0.035"
            material="blue_box" friction="1.3 0.01 0.001" solref="0.004 1"/>
    </body>
  </worldbody>

  <!--
    The stock SO-101 mesh has a single moving jaw. These inactive welds are a
    deliberate grasp-assist for the first task prototype: the controller turns
    one on only after the gripper reaches and closes around a box.
  -->
  <equality>
    <weld name="hold_red_box" body1="gripper" body2="red_box" active="false"
          solref="0.006 1" solimp="0.95 0.99 0.001"/>
    <weld name="hold_blue_box" body1="gripper" body2="blue_box" active="false"
          solref="0.006 1" solimp="0.95 0.99 0.001"/>
  </equality>

  <contact>
    <!-- The arm is mounted through the worktop; ignore the shoulder/worktop overlap. -->
    <exclude body1="world" body2="shoulder"/>
    <exclude body1="gripper" body2="red_box"/>
    <exclude body1="gripper" body2="blue_box"/>
    <exclude body1="moving_jaw_so101_v1" body2="red_box"/>
    <exclude body1="moving_jaw_so101_v1" body2="blue_box"/>
  </contact>
</mujoco>
